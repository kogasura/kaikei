/target
.env
# `.env` の派生（`.env.bak` / `.env.local` 等）も同じ扱いにする。
# 素の `.env` だけを無視していると、退避コピーを1つ作った瞬間に
# **DB パスワードが `git add -A` の射程に入る**（実際に `.env.bak` を
# 作って踏みかけた）。`.env.example` は配布物なので除外しない。
.env.*
!.env.example

# MCP クライアント（Claude Code 等）の設定。README「5分で動かす」の手順4が
# リポジトリ直下に作らせる。DB パスワードが平文で入るファイルであり、
# .env と同じ扱いにする。利用者の作業として残すと、worktree のときと同じく
# `git add -A` で誤ってコミットされる（.gitignore の下の注記を参照）。
.mcp.json

# CI の検査スクリプトを手元で走らせたときに残る。
__pycache__/
*.pyc

*.sqlite
*.sqlite3
.DS_Store
.claude/scheduled_tasks.lock

# AI エージェントが並列実装に使う一時的な git worktree。
# リポジトリ内に作られるため、git add -A で誤ってコミットされる
# （実際に一度踏んだ）。worktree の中身は元リポジトリのクローンなので
# 追跡する意味が無い。
.claude/worktrees/

# 帳簿の出力先。実際の金額が入るのでコミットしない
# （kaikei report --out の既定の置き場）
/tmp/
