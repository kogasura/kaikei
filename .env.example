# .env.example
#
# PostgreSQL 接続情報の雛形。開発時は `cp .env.example .env` してから値を埋める。
# `.env` は .gitignore 済みでコミットされない。docker-compose はこの `.env` を
# 自動で読み込む（docker-compose.yml の `${POSTGRES_PASSWORD}` 等の展開元）。
# cargo は読み込まないので、テストを走らせる前にシェルへ流し込むこと
# （`set -a; . ./.env; set +a`。README「テスト」を参照）。
#
# ★README の節名はこのファイルからの誘導先である★
# 節名を変えたら同じ PR でここも直すこと。
# `crates/kaikei-mcp/src/config.rs` の
# `the_readme_sections_named_by_the_env_example_exist` が突き合わせる。
#
# ロール構成（docs/03-database.md §1）:
#   kaikei_root      … コンテナ初期化用のスーパーユーザー
#   kaikei_migrator  … マイグレーション実行用ロール（テーブル/スキーマ所有者）
#   kaikei_app       … アプリ実行用ロール。journal_entries/journal_lines への
#                      UPDATE/DELETE/TRUNCATE 権限を持たない（append-only の強制）

# コンテナ初期化用スーパーユーザー（kaikei_root）のパスワード。docker-compose 専用。
POSTGRES_PASSWORD=CHANGE_ME

# kaikei_migrator ロールのパスワード。docker/postgres/init/01-roles.sql が
# ロール作成時に環境変数として読む（`\getenv`）。
KAIKEI_MIGRATOR_PASSWORD=CHANGE_ME

# ★ sqlx のツール群が「この名前で」読む接続。kaikei_migrator ロールを指す。
#
#   - `#[sqlx::test]`（pg-tests）… テストごとに使い捨てDBを作るため
#                                  CREATE DATABASE 権限が要る
#   - `cargo sqlx prepare`       … `.sqlx/` に無いクエリを実DBへ問い合わせる
#   - `sqlx migrate run`         … --database-url 省略時の既定
#
# 名前は sqlx 側で固定されており変更できない。kaikei_app を指すと
# `permission denied for database kaikei`（SQLSTATE 42501）で pg-tests が
# 全滅する。CI（.github/workflows/database.yml）も migrator を入れている。
DATABASE_URL=postgres://kaikei_migrator:CHANGE_ME@localhost:5432/kaikei

# `cargo run -p kaikei-store --bin kaikei-migrate` が読む接続。
# 内容は DATABASE_URL と同じだが、マイグレーション実行が「所有者ロールで
# 行う操作」であることを呼び出し側に明示させるために別名にしている
# （DATABASE_URL を migrator 以外に向けた環境でも壊れないようにするため）。
MIGRATOR_DATABASE_URL=postgres://kaikei_migrator:CHANGE_ME@localhost:5432/kaikei

# アプリ（kaikei-app / kaikei-store）が実行時に使う接続。kaikei_app ロール。
# append-only は「アプリがこのロールで繋ぐ」ことによって強制される
# （UPDATE/DELETE の権限が REVOKE されている）。
# Phase 3 の kaikei-mcp（合成ルート）がこの変数を読む。
#
# ★ここに kaikei_migrator を書かないこと★
# kaikei_migrator はテーブル所有者なので REVOKE をバイパスし、append-only の
# DB 権限による防御が丸ごと消える（docs/07-mcp-server.md §8）。
# kaikei-mcp は起動時に接続ロールの権限を検査し、帳簿への UPDATE/DELETE を
# 持つロールだった場合は起動を中止する。
APP_DATABASE_URL=postgres://kaikei_app:CHANGE_ME@localhost:5432/kaikei

# 権限テスト（append-only が DB 権限で強制されていることの検証）が
# kaikei_app ロールへ張り直すためのパスワード。
KAIKEI_APP_PASSWORD=CHANGE_ME

# =====================================================================
# kaikei-mcp（MCP サーバー）の事業者設定
# =====================================================================
#
# ★★ ここから下は、値を書かずにコメントアウトして配っている ★★
#
# `cp .env.example .env` してパスワードを埋めただけで起動できてしまうと、
# 利用者は**自分の帳簿が税抜経理か・課税事業者か**を一度も宣言しないまま
# 記帳を始めることになる。それは「既定値にフォールバックしない」という
# 決定（D-057 / D-082）を、配り方の側で骨抜きにするのと同じである。
# **コメントを外し、自分の帳簿に当てはまる値を書くこと。**
# 下に書いてあるのは「その項目が取りうる値」であって、推奨値ではない。
#
# ★1つでも欠けるとサーバーは起動しない（既定値にフォールバックしない）★
# 不足項目は全部まとめて stderr に並ぶので、1つずつ潰す必要はない。
#
# 課税事業者かどうか・税抜経理かどうか・端数をどう処理するかは、
# このソフトウェアが代わりに決めてよい種類の設定ではない
# （CLAUDE.md §10、DECISIONS.md D-057 / D-082、docs/07-mcp-server.md §7）。
# 指定を忘れたときに「もっともらしい既定値」で動くと、誤った前提のまま
# 消費税額の行が生成される（あるいは生成されない）ことになる。
#
# 各項目の意味は README「事業者設定」にある。**先に読んでから決めること。**
#
# MCP クライアントから起動する場合は、クライアント設定（Claude Code なら
# .mcp.json）の env に同じ値を書く。その場合ファイルに DB パスワードが
# 平文で置かれることになるので、ファイル権限に注意すること
# （docs/07-mcp-server.md §8）。

# 帳簿通貨。コードと小数桁数の組で解決される（JPY=0桁, USD=2桁）。
# 未知のコードは桁数を推測せずエラーになる（CLAUDE.md §8）。
#KAIKEI_BOOK_CURRENCY=JPY

# 会計年度の区切り規則。現在の対応値は calendar_year（暦年）のみ。
#KAIKEI_FISCAL_YEAR_RULE=calendar_year

# 経理方式。exclusive（税抜経理） / inclusive（税込経理）。
#KAIKEI_TAX_MODE=

# 端数処理方式。floor / ceil / half_up。
#KAIKEI_ROUNDING=

# 端数処理の単位。line（明細ごと） / document（請求書単位）。
#KAIKEI_ROUNDING_UNIT=

# 課税事業者なら true、免税事業者なら false。
# どちらであるかの判断はこのサーバーでは行わない。
#KAIKEI_IS_TAXABLE_BUSINESS=

# 簡易課税を選択しているなら true、そうでなければ false。
# どちらであるかの判断はこのサーバーでは行わない。
#KAIKEI_SIMPLIFIED_TAXATION=

# 決算処理に使う3科目のコード（同梱テンプレート sole_proprietor.yaml では
# 400 / 410 / 420）。勘定科目表に実在しない科目を指定すると起動時に
# 検出される（D-066）。科目コードを変えている場合は自分の帳簿の値を書く。
#KAIKEI_CLOSING_ACCOUNT_CAPITAL=400
#KAIKEI_CLOSING_ACCOUNT_OWNER_DRAWINGS=410
#KAIKEI_CLOSING_ACCOUNT_OWNER_CONTRIBUTIONS=420

# 決算振替の収益・費用ゼロ化明細に付ける消費税区分コード。
# 同梱の 2026 年度マスタに含まれる候補の1つが NOT_APPLICABLE（対象外）。
# どの区分を使うかの判断はこのサーバーでは行わない。
#KAIKEI_CLOSING_TAX_CATEGORY=

# 証憑ファイル（請求書・領収書）の保存先ディレクトリ。
#
# **attach と report と verify の3つが要求する。** 未設定だと attach は
# そもそも実行できず、report は証憑を書き出さず、verify は中身を検証しない。
#
# 内容の SHA-256 で保存する（同じ内容を2回入れてもファイルは1つ）。
# 電子取引データの保存は7年（青色欠損金があれば10年）で、失うと再取得が
# 難しい。**バックアップされる場所を選ぶこと。**
#
# 目安の容量は年 50〜150MB、7年で 1GB 程度。
#
# **Windows でもバックスラッシュを書かないこと。** `set -a && . ./.env` で
# 読むと bash がエスケープとして食い、C:\Users\... が C:Users... になる
# （実際に踏んだ。カレント直下に Usersyuuki_okubo... というフォルダができて、
# 証憑がそこへ書かれていた）。スラッシュで書けば Windows でも動く。
KAIKEI_BLOB_ROOT=C:/path/to/kaikei-documents
