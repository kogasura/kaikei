# .env.example
#
# PostgreSQL 接続情報の雛形。開発時は `cp .env.example .env` してから値を埋める。
# `.env` は .gitignore 済みでコミットされない。docker-compose はこの `.env` を
# 自動で読み込む（docker-compose.yml の `${POSTGRES_PASSWORD}` 等の展開元）。
# cargo は読み込まないので、テストを走らせる前にシェルへ流し込むこと
# （`set -a; . ./.env; set +a`。README「ローカル開発環境」を参照）。
#
# ロール構成（docs/03-database.md §1）:
#   kaikei_root      … コンテナ初期化用のスーパーユーザー
#   kaikei_migrator  … マイグレーション実行用ロール（テーブル/スキーマ所有者）
#   kaikei_app       … アプリ実行用ロール。journal_entries/journal_lines への
#                      UPDATE/DELETE/TRUNCATE 権限を持たない（append-only の強制）

# コンテナ初期化用スーパーユーザー（kaikei_root）のパスワード。docker-compose 専用。
POSTGRES_PASSWORD=CHANGE_ME

# kaikei_migrator ロールのパスワード。docker/postgres/init/01-roles.sql が
# ロール作成時に環境変数として読む（`\getenv`）。
KAIKEI_MIGRATOR_PASSWORD=CHANGE_ME

# ★ sqlx のツール群が「この名前で」読む接続。kaikei_migrator ロールを指す。
#
#   - `#[sqlx::test]`（pg-tests）… テストごとに使い捨てDBを作るため
#                                  CREATE DATABASE 権限が要る
#   - `cargo sqlx prepare`       … `.sqlx/` に無いクエリを実DBへ問い合わせる
#   - `sqlx migrate run`         … --database-url 省略時の既定
#
# 名前は sqlx 側で固定されており変更できない。kaikei_app を指すと
# `permission denied for database kaikei`（SQLSTATE 42501）で pg-tests が
# 全滅する。CI（.github/workflows/database.yml）も migrator を入れている。
DATABASE_URL=postgres://kaikei_migrator:CHANGE_ME@localhost:5432/kaikei

# `cargo run -p kaikei-store --bin kaikei-migrate` が読む接続。
# 内容は DATABASE_URL と同じだが、マイグレーション実行が「所有者ロールで
# 行う操作」であることを呼び出し側に明示させるために別名にしている
# （DATABASE_URL を migrator 以外に向けた環境でも壊れないようにするため）。
MIGRATOR_DATABASE_URL=postgres://kaikei_migrator:CHANGE_ME@localhost:5432/kaikei

# アプリ（kaikei-app / kaikei-store）が実行時に使う接続。kaikei_app ロール。
# append-only は「アプリがこのロールで繋ぐ」ことによって強制される
# （UPDATE/DELETE の権限が REVOKE されている）。
# Phase 1 時点でこの変数を読むコードはまだ無い（合成ルートは Phase 3 以降）。
APP_DATABASE_URL=postgres://kaikei_app:CHANGE_ME@localhost:5432/kaikei

# 権限テスト（append-only が DB 権限で強制されていることの検証）が
# kaikei_app ロールへ張り直すためのパスワード。
KAIKEI_APP_PASSWORD=CHANGE_ME
